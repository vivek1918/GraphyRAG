@prefix kg: <http://kg.example.org/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

kg:Concept a owl:Class ;
    rdfs:label "Concept" .

kg:LOCATED_IN a owl:ObjectProperty ;
    rdfs:label "LOCATED_IN" .

kg:Ontology_audio a owl:Ontology ;
    rdfs:comment "Standalone ontology for audio dataset with 5 documents" ;
    owl:versionInfo "audio-2025-11-24T21:11:20.178900" .

kg:Organization a owl:Class ;
    rdfs:label "Organization" .

kg:Person a owl:Class ;
    rdfs:label "Person" .

kg:Place a owl:Class ;
    rdfs:label "Place" .

kg:RELATED_TO a owl:ObjectProperty ;
    rdfs:label "RELATED_TO" .

