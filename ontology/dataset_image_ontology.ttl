@prefix kg: <http://kg.example.org/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

kg:Concept a owl:Class ;
    rdfs:label "Concept" .

kg:LOCATED_IN a owl:ObjectProperty ;
    rdfs:label "LOCATED_IN" .

kg:Ontology_image a owl:Ontology ;
    rdfs:comment "Standalone ontology for image dataset with 8 documents" ;
    owl:versionInfo "image-2025-11-24T21:11:20.179812" .

kg:Organization a owl:Class ;
    rdfs:label "Organization" .

kg:Person a owl:Class ;
    rdfs:label "Person" .

kg:Place a owl:Class ;
    rdfs:label "Place" .

kg:RELATED_TO a owl:ObjectProperty ;
    rdfs:label "RELATED_TO" .

kg:WORKS_FOR a owl:ObjectProperty ;
    rdfs:label "WORKS_FOR" .

